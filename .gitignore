# Keep .env.example in the repo; ignore real secrets and local DB.
.env
.env.local
.env.*.local

# SQLite: main file plus WAL sidecars created by journal_mode=WAL
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local copies of the live database. They contain real user data.
backups/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Logs and temp files
*.log
*.tmp
.DS_Store
Thumbs.db
